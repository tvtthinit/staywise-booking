apiVersion: v1
kind: Secret
metadata:
  name: n8n-secrets
  namespace: n8n
type: Opaque
stringData:
  DB_POSTGRESDB_USER: "<RDS_USERNAME>"
  DB_POSTGRESDB_PASSWORD: "<RDS_PASSWORD>"
  DB_POSTGRESDB_DATABASE: "n8n"
  DB_POSTGRESDB_HOST: "<RDS_ENDPOINT>"
  DB_POSTGRESDB_PORT: "5432"
  QUEUE_BULL_REDIS_HOST: "<REDIS_ENDPOINT>"
  QUEUE_BULL_REDIS_PORT: "6379"
  N8N_ENCRYPTION_KEY: "<GENERATE_A_LONG_STABLE_RANDOM_KEY>"
